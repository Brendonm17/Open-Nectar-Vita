/* Open Nectar — PS Vita vertex shader (Cg, compiled offline via psp2cgc).
 *
 * Faithful port of pc_port/gl/pc_gfx.cpp's `vShaderSrc` (GLSL #version 140).
 *
 * MATRIX CONVENTION: the port uploads with glUniformMatrix4fv(transpose=GL_FALSE)
 * and vitaGL lays that out so the Cg float4x4 equals the GL matrix, so the
 * transform is mul(vector, MATRIX), which computes M^T * v.
 *
 * That is NOT a stylistic choice, and the previous note here (that ACGC only
 * used this form because it uploads with GL_TRUE) was wrong. The port builds
 * sProjMatrix and sTexMatrices COLUMN-major and uploads them with GL_FALSE,
 * and vitaGL's glUniformMatrix4fv only transposes when the flag is GL_TRUE --
 * otherwise it memcpys. So register i holds COLUMN i and the float4x4 seen
 * here is the TRANSPOSE of the intended matrix; mul(v, M) undoes exactly that.
 * ACGC lands on the same buffer layout from the other direction (row-major
 * source + GL_TRUE), which is why it uses the same multiply order. Using
 * the wrong order transposes every transform: ortho translation lands in the
 * w row and the whole scene collapses to a tiny distorted blob at centre.
 *
 * Uniform NAMES match the GLSL side so pc_gfx.cpp's query works unchanged,
 * with GLSL arrays "name[i]" flattened to "name_i" (vita_gx_uniform_location).
 * Uniforms the port sets with glUniform1i are declared `int` here so the
 * S32 upload lands correctly (vitaGL does not convert int->float).
 *
 * Attributes bind by ATTRn register, matching bind_fixed_attrib_locations
 * (aPos=0, aColor=1, aNormal=2, aTexCoord0..3 = 3..6).
 * Varyings: vColor COLOR0 and vColor1 TEXCOORD5 (the FINAL rasterised
 * colours: material source times clamped channel lighting, per vertex as GX
 * does it; uMatSrc = chan0 rgb / chan0 alpha / chan1 rgb register selects),
 * vTexCoord0-3 TEXCOORD0-3, vFog TEXCOORD6 (the linear fog factor; every
 * fragment program reads it, so every vertex program must write it).
 */

float3 do_light(float3 N, float3 wp, float4 lp, float4 lc, float4 lk)
{
    float3 Ld = lp.xyz - wp;
    float dist = length(Ld);
    float3 L = Ld / max(dist, 0.001);
    float diff = max(dot(N, L), 0.0);
    if (lk.w > 0.5)
        diff *= saturate(lk.x + lk.y * dist + lk.z * dist * dist);
    return diff * lc.rgb;
}

float3 do_lights(float3 N, float3 wp, int n,
                 float4 lp0, float4 lp1, float4 lp2, float4 lp3,
                 float4 lc0, float4 lc1, float4 lc2, float4 lc3,
                 float4 lk0, float4 lk1, float4 lk2, float4 lk3)
{
    float3 sum = float3(0.0, 0.0, 0.0);
    if (n > 0) sum += do_light(N, wp, lp0, lc0, lk0);
    if (n > 1) sum += do_light(N, wp, lp1, lc1, lk1);
    if (n > 2) sum += do_light(N, wp, lp2, lc2, lk2);
    if (n > 3) sum += do_light(N, wp, lp3, lc3, lk3);
    return sum;
}

float2 pick_tc(int i, float2 t0, float2 t1, float2 t2, float2 t3)
{
    if (i == 0) return t0;
    if (i == 1) return t1;
    if (i == 2) return t2;
    return t3;
}

/* Mirrors genTc() in the GLSL: 0 = raw uv (no matrix); 1 = position;
 * 2 = normal; 3..10 = raw attribute texcoord (mode-3); >=11 = an earlier
 * generated coord (mode-11). Every non-zero mode goes through the texgen
 * matrix. */
float2 gen_tc(int mode, float4x4 M, float4 viewPos, float3 nrm, float2 uvIn,
              float2 g0, float2 g1, float2 g2, float2 g3,
              float2 a0, float2 a1, float2 a2, float2 a3)
{
    if (mode == 0) return uvIn;
    float4 src;
    if (mode == 1)       src = viewPos;
    else if (mode == 2)  src = float4(nrm, 1.0);
    else if (mode >= 11) src = float4(pick_tc(mode - 11, g0, g1, g2, g3), 0.0, 1.0);
    else                 src = float4(pick_tc(mode - 3,  a0, a1, a2, a3), 0.0, 1.0);
    return mul(src, M).xy;
}

void main(
    float3 aPos       : ATTR0,
    float4 aColor     : ATTR1,
    float3 aNormal    : ATTR2,
    float2 aTexCoord0 : ATTR3,
    float2 aTexCoord1 : ATTR4,
    float2 aTexCoord2 : ATTR5,
    float2 aTexCoord3 : ATTR6,
    float  aMtxIdx    : ATTR7,   /* GX PNMTXIDX / 3: palette slot 0..9 (constant 0 for CPU-path draws) */

    uniform float4x4 uProjMtx,
    /* Matrix palette: slot s occupies rows [3s..3s+2]; each row is one row of
     * the GX 3x4 matrix (x,y,z,translate). Position = dot(row, float4(p,1)). */
    /* Ten matrix slots (GX_PNMTX0..9), three rows each. vitaGL re-uploads a
     * uniform's DECLARED size every draw, so this is not free -- but the
     * one-slot version only held at the title, where every cached list used
     * slot 0. Gameplay indexes past it. */
    uniform float4 uPosPal[3],
    uniform float4 uNrmPal[3],

    /* channel 0 */
    uniform int uNumLights,
    uniform float4 uLightPos_0, uniform float4 uLightPos_1,
    uniform float4 uLightPos_2, uniform float4 uLightPos_3,
    uniform float4 uLightColor_0, uniform float4 uLightColor_1,
    uniform float4 uLightColor_2, uniform float4 uLightColor_3,
    uniform float4 uLightK_0, uniform float4 uLightK_1,
    uniform float4 uLightK_2, uniform float4 uLightK_3,
    uniform float4 uAmbColor,
    uniform int uChan0En,
    uniform float4 uMaterialColor,
    uniform float4 uMaterialColor1,
    uniform float4 uMatSrc,

    /* channel 1 */
    uniform int uNumLights1,
    uniform float4 uLightPos1_0, uniform float4 uLightPos1_1,
    uniform float4 uLightPos1_2, uniform float4 uLightPos1_3,
    uniform float4 uLightColor1_0, uniform float4 uLightColor1_1,
    uniform float4 uLightColor1_2, uniform float4 uLightColor1_3,
    uniform float4 uLightK1_0, uniform float4 uLightK1_1,
    uniform float4 uLightK1_2, uniform float4 uLightK1_3,
    uniform float4 uAmbColor1,
    uniform int uChan1En,
    uniform int uChan1AttnFn,
    uniform float4 uSpecHalf1,
    uniform float4 uSpecAttn1,

    /* texgen: mode + full 4x4 matrix per coord (port uploads uTcMtx[i]) */
    uniform int uTcMode_0, uniform int uTcMode_1,
    uniform int uTcMode_2, uniform int uTcMode_3,
    uniform float4x4 uTcMtx_0, uniform float4x4 uTcMtx_1,
    uniform float4x4 uTcMtx_2, uniform float4x4 uTcMtx_3,

    /* fog: x = 1/(end-start), y = -start/(end-start); all zero = fog off */
    uniform float4 uFogParams,

    out float4 out_position : POSITION,
    out float  vFog      : TEXCOORD6,
    out float4 vColor    : COLOR0,
    out float4 vColor1   : TEXCOORD5,
    out float2 vTexCoord0 : TEXCOORD0,
    out float2 vTexCoord1 : TEXCOORD1,
    out float2 vTexCoord2 : TEXCOORD2,
    out float2 vTexCoord3 : TEXCOORD3
) {
    /* Keep aMtxIdx referenced: the port binds 8 vertex streams, so the shader
     * must keep 8 attributes. With one palette slot this is always 0 (lists
     * that would use another slot are not cached - see kVitaDlMaxSlots). */
    int mi = int(aMtxIdx) * 3;
    float4 p4 = float4(aPos, 1.0);
    float4 worldPos = float4(dot(uPosPal[mi], p4), dot(uPosPal[mi + 1], p4), dot(uPosPal[mi + 2], p4), 1.0);
    out_position = mul(worldPos, uProjMtx);
    /* GX linear fog, per vertex: with the GameCube projection clip w is the
     * view depth, and (w - start)/(end - start) is linear in eye space, so the
     * perspective-correct interpolation gives the per-pixel GX value. The
     * fragment program clamps it and blends when uFogColour.a is set. */
    vFog = out_position.w * uFogParams.x + uFogParams.y;
    float3 N = normalize(float3(dot(uNrmPal[mi].xyz, aNormal), dot(uNrmPal[mi + 1].xyz, aNormal), dot(uNrmPal[mi + 2].xyz, aNormal)));

    float3 lit0 = uAmbColor.rgb + do_lights(N, worldPos.xyz, uNumLights,
        uLightPos_0, uLightPos_1, uLightPos_2, uLightPos_3,
        uLightColor_0, uLightColor_1, uLightColor_2, uLightColor_3,
        uLightK_0, uLightK_1, uLightK_2, uLightK_3);

    float3 spec1 = float3(0.0, 0.0, 0.0);
    if (uChan1AttnFn == 2 && uNumLights1 > 0) {
        float cosT = max(dot(N, normalize(uSpecHalf1.xyz)), 0.0);
        float att = saturate(uSpecAttn1.x + uSpecAttn1.y * cosT + uSpecAttn1.z * cosT * cosT);
        spec1 = att * uLightColor1_0.rgb;
    }
    float3 diffuse1 = (uChan1AttnFn == 2) ? float3(0.0, 0.0, 0.0)
        : do_lights(N, worldPos.xyz, uNumLights1,
            uLightPos1_0, uLightPos1_1, uLightPos1_2, uLightPos1_3,
            uLightColor1_0, uLightColor1_1, uLightColor1_2, uLightColor1_3,
            uLightK1_0, uLightK1_1, uLightK1_2, uLightK1_3);
    float3 lit1 = uAmbColor1.rgb + diffuse1 + spec1;

    /* Final rasterised colours (see the header). Explicit selects, not lerp:
     * a + (b - a) * 1 need not equal b exactly. */
    float3 lit0s = (uChan0En != 0) ? saturate(lit0) : float3(1.0, 1.0, 1.0);
    float3 lit1s = (uChan1En != 0) ? saturate(lit1) : float3(1.0, 1.0, 1.0);
    float3 base0 = (uMatSrc.x > 0.5) ? uMaterialColor.rgb : aColor.rgb;
    float  alpha0 = (uMatSrc.y > 0.5) ? uMaterialColor.a : aColor.a;
    float3 base1 = (uMatSrc.z > 0.5) ? uMaterialColor1.rgb : aColor.rgb;
    vColor  = float4(saturate(base0 * lit0s), alpha0);
    vColor1 = float4(saturate(base1 * lit1s), alpha0);

    float2 z = float2(0.0, 0.0);
    float2 tc0 = gen_tc(uTcMode_0, uTcMtx_0, worldPos, N, aTexCoord0, z,   z,   z,   z, aTexCoord0, aTexCoord1, aTexCoord2, aTexCoord3);
    float2 tc1 = gen_tc(uTcMode_1, uTcMtx_1, worldPos, N, aTexCoord1, tc0, z,   z,   z, aTexCoord0, aTexCoord1, aTexCoord2, aTexCoord3);
    float2 tc2 = gen_tc(uTcMode_2, uTcMtx_2, worldPos, N, aTexCoord2, tc0, tc1, z,   z, aTexCoord0, aTexCoord1, aTexCoord2, aTexCoord3);
    float2 tc3 = gen_tc(uTcMode_3, uTcMtx_3, worldPos, N, aTexCoord3, tc0, tc1, tc2, z, aTexCoord0, aTexCoord1, aTexCoord2, aTexCoord3);
    vTexCoord0 = tc0;
    vTexCoord1 = tc1;
    vTexCoord2 = tc2;
    vTexCoord3 = tc3;
}
