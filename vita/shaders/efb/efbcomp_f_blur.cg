// The GameCube distance blur (MapMgr BLEND_MultiTexture), as one pass:
// colour = last frame's blur (texture 0); alpha = blurAlpha * z * z with z the
// Z8 copy of this frame's depth (texture 1), in the TEV's 8-bit steps.
// vUV23.z carries blurAlpha (0..255). Blended src-alpha over the scene.
float4 main(float4 vUV01 : TEXCOORD0, float4 vUV23 : TEXCOORD1,
            uniform sampler2D uBlur : TEXUNIT0, uniform sampler2D uZ : TEXUNIT1) : COLOR
{
    float3 c = tex2D(uBlur, vUV01.xy).rgb;
    float z8 = floor(tex2D(uZ, vUV01.xy).a * 255.0f + 0.5f);
    float zz = floor(z8 * z8 / 255.0f + 0.5f);
    float a = floor(zz * vUV23.z / 255.0f + 0.5f);
    return float4(c, a / 255.0f);
}
