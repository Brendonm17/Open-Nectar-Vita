// EFB copy to GX_TF_RGB565: the colour quantised to 5/6/5 bits and expanded back
// the way the texture unit reads it (v5 << 3 | v5 >> 2), alpha opaque.
float4 main(float4 vUV01 : TEXCOORD0, float4 vUV23 : TEXCOORD1, uniform sampler2D uTex : TEXUNIT0) : COLOR
{
    float3 c = (tex2D(uTex, vUV01.xy).rgb + tex2D(uTex, vUV01.zw).rgb + tex2D(uTex, vUV23.xy).rgb + tex2D(uTex, vUV23.zw).rgb) * 0.25f;
    float3 v8 = floor(c * 255.0f + 0.5f);
    float3 q = floor(v8 / float3(8.0f, 4.0f, 8.0f));
    float3 e = float3(q.x * 8.0f + floor(q.x / 4.0f), q.y * 4.0f + floor(q.y / 16.0f), q.z * 8.0f + floor(q.z / 4.0f));
    return float4(e / 255.0f, 1.0f);
}
