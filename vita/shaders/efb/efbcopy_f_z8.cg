// EFB depth copy to GX_TF_Z8: the top 8 bits of the 24-bit depth.
float4 main(float4 vUV01 : TEXCOORD0, float4 vUV23 : TEXCOORD1, uniform sampler2D uTex : TEXUNIT0) : COLOR
{
    float d = (tex2D(uTex, vUV01.xy).x + tex2D(uTex, vUV01.zw).x + tex2D(uTex, vUV23.xy).x + tex2D(uTex, vUV23.zw).x) * 0.25f;
    float z8 = floor(saturate(d) * 16777215.0f / 65536.0f);
    z8 = min(z8, 255.0f) / 255.0f;
    return float4(z8, z8, z8, z8);
}
