// The GX display copy's vertical filter: rows y-1, y, y+1 (vUV01.xy, vUV01.zw,
// vUV23.xy) weighted edge, centre, edge (vUV23.z, vUV23.w, vUV23.z).
float4 main(float4 vUV01 : TEXCOORD0, float4 vUV23 : TEXCOORD1, uniform sampler2D uTex : TEXUNIT0) : COLOR
{
    return (tex2D(uTex, vUV01.xy) + tex2D(uTex, vUV23.xy)) * vUV23.z + tex2D(uTex, vUV01.zw) * vUV23.w;
}
